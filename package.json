{
  "name": "relics-of-the-six-temples",
  "private": true,
  "version": "0.1.0",
  "description": "Relics of the Six Temples \u2014 Season 2. A 2D cinematic action-platformer / environmental puzzle adventure for HTML5/WebGL.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate-levels": "tsx scripts/validate-levels.ts",
    "docs:levels": "tsx scripts/gen-level-spec.ts",
    "build:single": "node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
